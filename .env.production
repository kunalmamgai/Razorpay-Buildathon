# ═══════════════════════════════════════════════════════════════════════
# RazorCage AI — Production Environment Variable Blueprint
# ═══════════════════════════════════════════════════════════════════════
APP_ENV=production

# Gemini AI API Configuration
GEMINI_API_KEY=your_production_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Merchant Credentials
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# Production PostgreSQL Database Pool
DATABASE_URL=postgresql://razorcage_user:razorcage_secure_password_2026@postgres:5432/razorcage_db
READ_REPLICA_URL=postgresql://razorcage_user:razorcage_secure_password_2026@postgres:5432/razorcage_db

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
