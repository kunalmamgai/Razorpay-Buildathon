# ══════════════════════════════════════════════════════════════
# Marlin Growth Agent — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# Gemini API key for the Brain (required for AI proposals)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# Razorpay test mode keys (required for payment flow)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# Razorpay webhook secret (optional — for webhook signature verification)
RAZORPAY_WEBHOOK_SECRET=

# SQLite database path (optional — defaults to backend/data/marlin.db)
DATABASE_URL=

# Campaign orchestrator review interval in minutes (optional — default 60)
CAMPAIGN_REVIEW_INTERVAL_MINUTES=60
